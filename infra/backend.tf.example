terraform {
  # Copy this block into backend.tf after creating the state bucket.
  # Keep the bucket outside this stack so bootstrap does not depend on itself.
  backend "s3" {
    bucket       = "REPLACE_WITH_TERRAFORM_STATE_BUCKET"
    key          = "erp-receiving-platform/terraform.tfstate"
    region       = "ap-northeast-1"
    encrypt      = true
    dynamodb_table = "REPLACE_WITH_TERRAFORM_LOCK_TABLE"
  }
}
