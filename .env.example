AWS_REGION=ap-northeast-1
ERP_ENVIRONMENT=local
ERP_SEED_DEMO=true
# Set this only when using DynamoDB instead of the local in-memory store.
# ERP_DYNAMODB_TABLE_NAME=erp-receiving-platform-data
# Optional SNS topic; local mode logs alerts when this is empty.
# ERP_ALERT_TOPIC_ARN=arn:aws:sns:ap-northeast-1:123456789012:erp-alerts
# Keep false unless an explicitly trusted MCP client may mutate ERP data.
ERP_MCP_MUTATIONS_ENABLED=false
# staging/production derive actor and roles from API Gateway JWT claims.
# local/test may use X-Demo-Actor and X-Demo-Roles for demo-only calls.
# ERP_IMPORT_BUCKET_NAME=erp-receiving-platform-imports
ERP_IDEMPOTENCY_TTL_DAYS=90
ERP_ALERT_OUTBOX_TTL_DAYS=30
ERP_ALERT_LEASE_SECONDS=300
